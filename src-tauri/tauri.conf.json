{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurelia Launch",
  "version": "0.1.0",
  "identifier": "works.aurelia.launch",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aurelia Launch",
        "width": 640,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/128x128.png"],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
